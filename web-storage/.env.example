PORT=9000
HOST=0.0.0.0
NODE_ENV=development

# Nama folder CDN yang diset dari luar (default: cdn-global)
CDN_FOLDER=cdn-global

# (Opsional) Custom path lengkap folder CDN
# CDN_STORAGE_PATH=/Users/muhammadimamrozali/Products/working-space/cdn-global

# Secret untuk upload dan delete (header X-API-Key). Minimal 32 karakter.
# Buat dengan: openssl rand -hex 32
# Jika kosong: upload/delete dinonaktifkan (development) atau server menolak start (production).
STORAGE_API_KEY=

# Batas ukuran upload dalam byte (default 50 MB)
MAX_UPLOAD_SIZE=52428800
