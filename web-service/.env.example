PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Security & Pairing Configurations
PAIR_CODE_EXPIRY_MS=600000
MAX_ATTEMPTS_PER_CODE=5
RATE_LIMIT_PER_MINUTE=10

# Ukuran frame WebSocket maksimum dalam byte (default 1 MB)
MAX_PAYLOAD_BYTES=1048576

# Origin browser yang boleh membuka koneksi, dipisah koma.
# Kosongkan untuk memakai default development (Vite 5173, Tauri 1420, skema tauri://).
# ALLOWED_ORIGINS=https://app.example.com,tauri://localhost
